{
  "name": "@component-canvas/vue",
  "version": "0.1.0",
  "description": "Vue SFC adapter for Component Canvas: parsing, mutation, preview, and component metadata.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeInKlingon/component-canvas.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@component-canvas/shared": "workspace:*",
    "@vue/compiler-dom": "^3.5.17",
    "@vue/compiler-sfc": "^3.5.17",
    "@vue/shared": "^3.5.17",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.6",
    "vue-component-meta": "^3.3.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0",
    "vue": "^3.5.0"
  }
}
